# Production Environment Configuration
ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your-secure-random-key-here-min-32-chars

# Frontend CORS
API_CORS_ORIGINS=https://cyber-ai-system.vercel.app

# Database (PostgreSQL on Railway)
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# AI Provider - Gemini
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# AI Configuration
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_INPUT_CHARS=4000
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY_SECONDS=0.5

# Terminal Engine
TERMINAL_WORKSPACE_ROOT=/tmp
TERMINAL_DEFAULT_TIMEOUT_SECONDS=30
TERMINAL_MAX_TIMEOUT_SECONDS=120
TERMINAL_MAX_STDOUT_BYTES=1000000
TERMINAL_MAX_STDERR_BYTES=1000000
TERMINAL_SESSION_TTL_SECONDS=900
TERMINAL_MAX_CONCURRENT_SESSIONS=20

# Termux Connector
TERMUX_PAIRING_CODE_TTL_SECONDS=300
TERMUX_MAX_REGISTERED_DEVICES=50
