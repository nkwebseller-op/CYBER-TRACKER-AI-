# Copy to .env. Never commit the filled-in file.
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data

# Providers. The defaults run fully offline (no API keys needed).
SCRIPT_PROVIDER=template
VOICE_PROVIDER=mock          # mock | elevenlabs
VIDEO_PROVIDER=cards

# Only for VOICE_PROVIDER=elevenlabs. Usage is billed to your ElevenLabs account.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# 0 = no cap on videos per day. Set a number to protect your provider budget.
MAX_JOBS_PER_DAY=0
MAX_CONCURRENT_JOBS=2
MAX_PROMPT_CHARS=4000
