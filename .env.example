# Copy to .env. Never commit the filled-in file.
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data

# Providers. The defaults run fully offline (no API keys needed).
SCRIPT_PROVIDER=template
VOICE_PROVIDER=mock          # mock | elevenlabs
VIDEO_PROVIDER=cards         # cards | replicate

# Only for VOICE_PROVIDER=elevenlabs. Usage is billed to your ElevenLabs account.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Only for VIDEO_PROVIDER=replicate. Every scene is a paid text-to-video run on your account.
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=google/veo-3.1-fast
# Merged into each prediction input. Field names differ per model: check the model's API tab.
REPLICATE_VIDEO_INPUT={"generate_audio": false, "resolution": "720p"}
REPLICATE_CLIP_SECONDS=8
REPLICATE_TIMEOUT_SECONDS=600
REPLICATE_MAX_CLIPS=6        # refuses scripts with more scenes, before spending anything

# 0 = no cap on videos per day. Set a number to protect your provider budget.
MAX_JOBS_PER_DAY=0
MAX_CONCURRENT_JOBS=2
MAX_PROMPT_CHARS=4000
