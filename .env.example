# Copy to .env at repo root (and/or apps/api/.env) and fill in real values.
# Never commit the filled-in file.

# --- API ---
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-to-a-random-64-char-string

# --- Database ---
DATABASE_URL=postgresql+asyncpg://cyberai:cyberai@localhost:5432/cyberai
DATABASE_URL_SYNC=postgresql+psycopg://cyberai:cyberai@localhost:5432/cyberai

# --- AI Provider (Gemini primary; "mock" for local dev without spending API credits) ---
# AI_PROVIDER=mock is refused at startup when ENVIRONMENT=production.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Cost/latency/token controls for the AI provider (see services/agent/chat_pipeline.py)
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_INPUT_CHARS=4000
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY_SECONDS=0.5

# --- Terminal Engine (see services/terminal/config.py) ---
# TERMINAL_WORKSPACE_ROOT=
TERMINAL_DEFAULT_TIMEOUT_SECONDS=30
TERMINAL_MAX_TIMEOUT_SECONDS=120
TERMINAL_MAX_STDOUT_BYTES=1000000
TERMINAL_MAX_STDERR_BYTES=1000000
TERMINAL_SESSION_TTL_SECONDS=900
TERMINAL_MAX_CONCURRENT_SESSIONS=20
# Windows only: override PowerShell path. Empty = auto-detect (pwsh, then
# powershell.exe) — see services/terminal/adapters/windows.py.
TERMINAL_WINDOWS_POWERSHELL_PATH=
# Linux only: override the shell path (informational; argv is always
# executed directly). Empty = auto-detect ($SHELL, then bash/sh) — see
# services/terminal/adapters/linux.py.
TERMINAL_LINUX_SHELL_PATH=
# macOS only: override the shell path (informational; argv is always
# executed directly). Empty = auto-detect ($SHELL, then zsh/bash/sh) — see
# services/terminal/adapters/macos.py.
TERMINAL_MACOS_SHELL_PATH=

# --- Frontend (public, non-secret only) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# --- CORS ---
API_CORS_ORIGINS=http://localhost:3000
